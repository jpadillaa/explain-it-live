# Lección activa (ruta relativa al proyecto). Reinicia el servidor tras cambiarla.
LESSON_FILE=lessons/nube-nist.md
# LESSON_FILE=lessons/arduino-electronica.md

# Azure OpenAI (API v1)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_1=gpt-5.4-mini
# Opcional: despliegue para diseñar artefactos (HTML, SVG, Mermaid, Vega-Lite).
# Si se omite, se usa AZURE_OPENAI_DEPLOYMENT_1. Con el proveedor alternativo: TUTOR_ARTIFACT_MODEL.
AZURE_OPENAI_DEPLOYMENT_ARTIFACTS=

# Proveedor alternativo compatible
# Sin clave, se activa el tutor local de demostración.
TUTOR_API_KEY=
TUTOR_MODEL=gpt-4.1-mini
TUTOR_BASE_URL=https://api.openai.com/v1

# Proveedor de voz: elevenlabs, kokoro-api o local. Sin valor: ElevenLabs si
# está configurado; si no, Kokoro local en proceso (npm run professor:prepare).
# kokoro-api usa Kokoro-FastAPI, sin coste por uso, para probar sin gastar créditos:
#   docker run -d --rm --name kokoro -p 127.0.0.1:8880:8880 ghcr.io/remsky/kokoro-fastapi-cpu:latest
SPEECH_PROVIDER=
KOKORO_API_URL=http://127.0.0.1:8880
# Voces en español: ef_dora (femenina), em_alex y em_santa (masculinas).
KOKORO_API_VOICE=ef_dora
KOKORO_API_SPEED=1

# Voz del profesor en ElevenLabs. Completa clave y voice ID para activarla.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
